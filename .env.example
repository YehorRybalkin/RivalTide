# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection (Supabase: Project Settings → Database → Connection string).
# Use the session pooler or direct connection (port 5432) for the worker.
# With Supabase's transaction pooler (port 6543) also set DATABASE_PREPARE=false.
DATABASE_URL=postgres://rivaltide:rivaltide@localhost:5432/rivaltide
# DATABASE_PREPARE=false
# DATABASE_POOL_MAX=10
APP_URL=http://localhost:3000
# SESSION_TTL_DAYS=30
# TRIAL_DAYS=14

# ─── Monitoring (worker) ─────────────────────────────────────────────────────
# MONITOR_USER_AGENT="RivalTideBot/1.0 (+https://your-domain.com/bot)"
# MONITOR_ROBOTS_TOKEN=RivalTideBot
# MONITOR_TIMEOUT_MS=15000
# MONITOR_MAX_BYTES=3000000
# MONITOR_MAX_REDIRECTS=5
# Minimum spacing between requests to the same origin (crawl-delay overrides upward)
# MONITOR_DOMAIN_INTERVAL_MS=10000
# Enable Playwright rendering for pages marked "JavaScript rendering" (worker only; needs Chromium)
# MONITOR_BROWSER_ENABLED=true
# PLAYWRIGHT_CHROMIUM_PATH=
# WORKER_CONCURRENCY=4
# WORKER_POLL_MS=5000
# SNAPSHOT_RETENTION_DAYS=180
# DEVELOPMENT/TEST ONLY — never set in production (startup fails if NODE_ENV=production):
# MONITOR_ALLOW_PRIVATE_HOSTS=127.0.0.2

# ─── AI (optional) ───────────────────────────────────────────────────────────
# anthropic | openai | none. Without a key, RivalTide uses deterministic rule-based insights.
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Defaults: claude-opus-5-5 (anthropic), gpt-5-mini (openai). Lower-cost option: claude-haiku-5-5
# AI_MODEL=
# AI_TIMEOUT_MS=60000
# AI_MAX_INPUT_CHARS=12000

# ─── Email (optional) ────────────────────────────────────────────────────────
# log = local stub (prints to console in development, records "skipped_not_configured")
EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM="RivalTide <alerts@your-domain.com>"

# ─── Billing (optional — checkout stays disabled until ALL are set) ─────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_AGENCY=

# ─── Ops ─────────────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/monitor (fallback scheduler when no worker runs)
# CRON_SECRET=
# SENTRY_DSN=
